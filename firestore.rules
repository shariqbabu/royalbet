rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    match /wallets/{uid} {
      allow read: if request.auth.uid == uid;
      allow write: if request.auth.uid == uid;
    }

    match /transactions/{id} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /bethistory/{id} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth    allow write: if false;
    }

    match /deposits/{id} {
      allow create: if request.auth != null;
      allow read: if request.auth.uid == resource.data.uid;
    }

    match /ticTacToeTables/{tableId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /gameRooms/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /ludoTables/{tableId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /ludoGames/{tableId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /nineCardTables/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /jokerPairTables/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /jokerPairGames/{tableId} {
      allow read: if request.auth != null;
      allow write: if false;

      // 🎯 Private hands — sirf apna hand readable
      match /private/{docId} {
        allow read: if request.auth != null && request.auth.uid == docId;
        allow write: if false;
      }
    }

    match /tambolaTables/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /tambolaGames/{id} {
      allow read: if request.auth != null;
      allow write: if false;

      match /private/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    match /pokerTables/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /lobbies/{tableId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    match /withdrawals/{id} {
      allow read: if request.auth.uid == resource.data.uid;
      allow write: if false;
    }
  }
}
